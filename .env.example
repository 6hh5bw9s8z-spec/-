# ===== Square 連携設定 =====
# Square Developer Dashboard (https://developer.squareup.com/apps) で取得します。
# このファイルを .env.local にコピーして値を入れてください。
# 未設定の間、EC はデモモード（決済なしで完了画面へ）、予約は電話案内で動きます。

# sandbox（テスト）か production（本番）か
SQUARE_ENVIRONMENT=sandbox

# アクセストークン（Sandbox はダッシュボードの Sandbox Access Token）
SQUARE_ACCESS_TOKEN=

# ロケーションID（Square ダッシュボード > 設定 > ビジネス > ロケーション）
SQUARE_LOCATION_ID=

# ----- Square 予約（Square Appointments）-----
# どちらか一方を設定すると /reserve に反映されます。
# 予約ページの URL（Square ダッシュボード > 予約 > オンライン予約 で確認）
NEXT_PUBLIC_SQUARE_APPOINTMENTS_URL=

# 埋め込みウィジェットの script URL（発行している場合のみ）
NEXT_PUBLIC_SQUARE_APPOINTMENTS_WIDGET_URL=
